MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/FoodDelivery_Database
FIRST_SECRET_KEY=replace-with-a-long-random-secret
USER_JWT_SECRET=replace-with-a-long-random-user-secret
ADMIN_JWT_SECRET=replace-with-a-long-random-admin-secret
CSRF_SECRET=replace-with-a-long-random-csrf-secret
NODE_ENV=production
CLIENT_ORIGINS=https://your-client-domain.com,https://your-admin-domain.com
COOKIE_SAME_SITE=none
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
